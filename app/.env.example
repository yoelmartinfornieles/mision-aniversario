# Google Apps Script mailer (see scripts/google-apps-script/README.md).
# Baked into the client at build time — treat the secret as semi-public.
VITE_GAS_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
VITE_GAS_MAIL_SECRET=replace-with-same-as-script-property-MAIL_SECRET

# Optional: Airbnb listing URL included in the finale email body.
# VITE_AIRBNB_URL=https://www.airbnb.com/rooms/XXXX
